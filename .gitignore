# secrets — this line first, before any file that could hold one
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.swp
__pycache__/
node_modules/

# charter references professional names, a lot number, an LLC — keep it local,
# not in the public repo. The build session reads it from disk.
docs/CHARTER.md

# correspondence exports (WhatsApp/email) — names, phone numbers, .vcf contacts.
# The build session reads them from disk to seed decision_log; they never get committed.
docs/WhatsApp Chat*/
docs/*.vcf
*.txt.export
